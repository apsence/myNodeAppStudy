# Скопируйте в .env
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/bbmo_01_23
DB_NAME=bbmo_01_23

# Задание 4 и 5: секреты JWT (минимум 32 символа, у access и refresh — РАЗНЫЕ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=10

# CORS: белый список источников через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Rate limiting: запросов на IP в окно
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# За обратным прокси (nginx и т.п.) включите, чтобы брать IP из X-Forwarded-For
TRUST_PROXY=false

# Задание 5
LOG_LEVEL=info
UPLOAD_DIR=uploads
# SMTP необязателен: без него письма «отправляются» в лог (jsonTransport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BBMO <noreply@bbmo.example>"
# HTTPS (если не за прокси): пути к ключу и сертификату
TLS_KEY=
TLS_CERT=
