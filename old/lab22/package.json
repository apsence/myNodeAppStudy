{
  "name": "lab22-mysql-nodejs",
  "version": "1.0.0",
  "description": "Лабораторная работа №22: подключение к MySQL и работа с БД из Node.js (ББМО-01-23)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "task1": "node mysql-connect.js",
    "task2": "node mysql-crud.js",
    "task3": "node mysql-errors.js",
    "task4": "node mysql-dao.js",
    "task5": "node server.js",
    "show-env": "node mysql-connect.js --show-env",
    "setup-db": "node scripts/setup-db.js",
    "reset-db": "node scripts/reset-db.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed.js",
    "demo": "node scripts/demo-requests.js",
    "test": "node --test --test-reporter=spec",
    "test:1": "node --test --test-reporter=spec \"tests/task1.*.test.js\"",
    "test:2": "node --test --test-reporter=spec \"tests/task2.*.test.js\"",
    "test:3": "node --test --test-reporter=spec \"tests/task3.*.test.js\"",
    "test:4": "node --test --test-reporter=spec \"tests/task4.*.test.js\"",
    "test:5": "node --test --test-reporter=spec \"tests/task5.*.test.js\""
  },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "dotenv": "^16.4.5",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "mysql2": "^3.11.3"
  }
}
