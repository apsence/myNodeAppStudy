# Скопируйте в .env и поправьте под свою установку MongoDB
# Формат из задания (с аутентификацией):
# MONGODB_URI=mongodb://student:password@localhost:27017/bbmo_01_23
# Без аутентификации (подходит для docker-compose из проекта):
MONGODB_URI=mongodb://localhost:27017/bbmo_01_23
DB_NAME=bbmo_01_23

# Задание 5
HTTP_PORT=3000
WS_PORT=3001
CACHE_TTL_SECONDS=60

# Задание 3: сколько документов генерировать (по заданию 1 000 000)
BIG_SIZE=1000000
